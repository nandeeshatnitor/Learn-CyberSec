# Copy to .env (or run `make setup`, which also generates strong random passwords).
# .env is git-ignored. Never commit real credentials.

# --- Shared / Docker Compose -------------------------------------------------
POSTGRES_USER=cvelearn
POSTGRES_PASSWORD=change_me
POSTGRES_DB=cvelearn
REDIS_PASSWORD=change_me

# --- Backend (host-based development; containers get these from docker-compose.yml) ---
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_JSON=false
DATABASE_URL=postgresql+psycopg://cvelearn:change_me@localhost:5432/cvelearn
REDIS_URL=redis://:change_me@localhost:6379/0
# Comma-separated origins allowed to call the API from a browser.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Frontend ----------------------------------------------------------------
# Server-side only: used by Next.js server components. Never prefix with NEXT_PUBLIC_.
BACKEND_URL=http://localhost:8000

# --- Ports published on 127.0.0.1 by docker compose ---------------------------
BACKEND_PORT=8000
FRONTEND_PORT=3000
POSTGRES_PORT=5432
REDIS_PORT=6379

# External data-source API keys (NVD, GitHub, ...) are not needed yet; they will be added in
# the retrieval phase and must only ever be read by the backend.
