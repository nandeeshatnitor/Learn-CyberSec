# Copy to .env (or run `make setup`, which also generates strong random passwords).
# .env is git-ignored. Never commit real credentials.

# --- Shared / Docker Compose -------------------------------------------------
POSTGRES_USER=cvelearn
POSTGRES_PASSWORD=change_me
POSTGRES_DB=cvelearn
REDIS_PASSWORD=change_me

# --- Backend (host-based development; containers get these from docker-compose.yml) ---
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_JSON=false
DATABASE_URL=postgresql+psycopg://cvelearn:change_me@localhost:5432/cvelearn
REDIS_URL=redis://:change_me@localhost:6379/0
# Comma-separated origins allowed to call the API from a browser.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Frontend ----------------------------------------------------------------
# Server-side only: used by Next.js server components. Never prefix with NEXT_PUBLIC_.
BACKEND_URL=http://localhost:8000

# --- Ports published on 127.0.0.1 by docker compose ---------------------------
BACKEND_PORT=8000
FRONTEND_PORT=3000
POSTGRES_PORT=5432
REDIS_PORT=6379

# --- External vulnerability data providers (backend only) ---------------------------------
# Which providers to use: nvd, mitre, cisa_kev (comma-separated). The site keeps working if
# one of them is down.
ENABLED_PROVIDERS=nvd,mitre,cisa_kev
# Optional. Raises NVD's rate limit from 5 to 50 requests per 30 seconds. Request one at
# https://nvd.nist.gov/developers/request-an-api-key. Only ever sent to NVD, in a header; never
# exposed to the frontend or logged.
NVD_API_KEY=

# How long fetched data is served from cache without asking the provider again, and how long
# an expired copy is kept as a fallback when a provider is down (seconds).
CACHE_TTL_SECONDS=21600
CACHE_STALE_TTL_SECONDS=604800
CACHE_SEARCH_TTL_SECONDS=900
KEV_CACHE_TTL_SECONDS=21600

# Per-client-IP limit on the CVE endpoints (requests per window).
API_RATE_LIMIT_REQUESTS=60
API_RATE_LIMIT_WINDOW_SECONDS=60

# Proxies whose X-Forwarded-For header the API may believe, so limits apply per visitor rather
# than to the web server as a whole. Leave empty for plain local development. Behind a real
# reverse proxy set this to its address/CIDR AND make that proxy overwrite X-Forwarded-For.
TRUSTED_PROXIES=

# Advanced (defaults are usually right): NVD_BASE_URL, MITRE_BASE_URL, KEV_FEED_URL,
# NVD_RATE_LIMIT_REQUESTS, PROVIDER_READ_TIMEOUT_SECONDS, CIRCUIT_FAILURE_THRESHOLD, ...
# ALLOW_INSECURE_PROVIDER_URLS=true is for local fake providers only and is refused in production.

# --- Learning-guide research (phase 2; backend and worker only) -----------------------------
RESEARCH_ENABLED=true
# auto: use a language model when ANTHROPIC_API_KEY is set, otherwise quote the sources
# (extractive). llm: require the key. extractive: never call a model.
RESEARCH_SYNTHESIS=auto
# Optional. Only ever sent to the Anthropic API; never exposed to the frontend, logged or stored.
ANTHROPIC_API_KEY=
RESEARCH_MODEL=claude-opus-5-5
# Optional. Raises GitHub's API rate limit; only ever sent to api.github.com.
GITHUB_TOKEN=
# auto: RQ workers when REDIS_URL is set (run `make worker` or the compose "worker" service),
# otherwise a thread in the API process. inline runs jobs inside the request: tests only.
RESEARCH_JOB_BACKEND=auto
# Cost and abuse limits: new research runs per client IP per hour, and per day overall.
RESEARCH_PER_IP_RUNS_PER_HOUR=5
RESEARCH_DAILY_RUN_BUDGET=200
# Advanced: RESEARCH_GUIDE_TTL_SECONDS, RESEARCH_REFRESH_COOLDOWN_SECONDS, RESEARCH_MAX_DOCUMENTS,
# RESEARCH_MAX_SOURCES_USED, RESEARCH_DEADLINE_SECONDS, RESEARCH_CRAWL_DELAY_SECONDS,
# RESEARCH_FETCH_MAX_BYTES, RESEARCH_DISCOVER_GITHUB, RESEARCH_STALE_RUN_SECONDS, ...

# --- Sandboxed labs (phase 4; OFF by default) --------------------------------------------------
# Needs a Docker daemon the backend may drive (ideally a dedicated or rootless one), root for the host
# firewall rule, and the lab images built locally (`make lab-images`). See docs/sandbox.md.
SANDBOX_ENABLED=false
# Lab lease scaling for demos/tests (1.0 = the definition's timeout; only ever shortens).
SANDBOX_TIMEOUT_SCALE=1.0
# Where the browser's terminal WebSocket connects, if not the site's own origin (e.g. wss://labs.example.com).
# The same origin must be given to the web app as TERMINAL_WS_ORIGIN (runtime, server-side).
SANDBOX_TERMINAL_PUBLIC_URL=
TERMINAL_WS_ORIGIN=

# --- Candidate labs and reviewer administration (phase 5; OFF by default) ----------------------
# Turns documented CVE research into *candidate* labs that are built and tested automatically and
# then wait for a person. Nothing is ever published without a reviewer's approval. Needs the sandbox
# (above) and a labgen worker with Docker access (`make labgen-worker`). See docs/labgen.md.
LABGEN_ENABLED=false
# Reviewers: comma-separated name=<sha256 of their token>. Make one with
# `python scripts/admin_token.py alice`. No reviewers configured means the review interface is closed.
ADMIN_REVIEWERS=
# Wrong reviewer tokens per client per minute before requests are refused.
ADMIN_AUTH_FAILURES_PER_MINUTE=10
# Optional: let a language model polish the *wording* (objective, summary) of a candidate. It never
# writes code, files or the lab definition. Uses ANTHROPIC_API_KEY; falls back to fixed wording.
LABGEN_USE_LLM=true
# Base images a generated Dockerfile may use (must already be present locally: builds are offline).
LABGEN_BASE_IMAGES=python:3.12-alpine
# Advanced: LABGEN_QUEUE_NAME, LABGEN_JOB_TIMEOUT_SECONDS, LABGEN_BUILD_TIMEOUT_SECONDS.
